 school\", \"High school\" ],\r\n      \"modified\": \"2016-09-27\",\r\n      \"publisher\": {\r\n        \"@type\": \"org:Organization\",\r\n        \"name\": \"Office of Safe and Healthy Students\",\r\n        \"subOrganizationOf\": {\r\n          \"@type\": \"org:Organization\",\r\n          \"name\": \"Office of Elementary and Secondary Education\",\r\n          \"subOrganizationOf\": {\r\n            \"@type\": \"org:Organization\",\r\n            \"name\": \"U.S. Department of Education\",\r\n            \"subOrganizationOf\": {\r\n              \"@type\": \"org:Organization\",\r\n              \"name\": \"U.S. Government\"\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"contactPoint\": {\r\n        \"@type\": \"vcard:Contact\",\r\n        \"fn\": \"Kelly Worthington\",\r\n        \"hasEmail\": \"mailto:kelly.worthington@ed.gov\"\r\n      },\r\n      \"identifier\": \"OPEPD_2012012\",\r\n      \"accessLevel\": \"restricted public\",\r\n      \"bureauCode\": [ \"018:10\" ],\r\n      \"programCode\": [ \"018:000\" ],\r\n      \"license\": \"https://creativecommons.org/publicdomain/zero/1.0/\",\r\n      \"spatial\": \"United States\",\r\n      \"temporal\": \"2012/2013\",\r\n      \"accrualPeriodicity\": \"R/P1Y\",\r\n      \"dataQuality\": true,\r\n      \"language\": [ \"en-US\" ],\r\n      \"landingPage\": \"https://www2.ed.gov/about/inits/ed/edfacts/index.html\"\r\n    },\r\n    {\r\n      \"@type\": \"dcat:Dataset\",\r\n      \"title\": \"EDFacts School Improvement Grant, 2010-11\",\r\n      \"description\": \"EDFacts School Improvement Grant, 2010-11 (EDFacts SIG:2010-11), is one of 17 'topics' identified in the EDFacts documentation (in this database, each 'topic' is entered as a separate study); program data is available since 2005 at <ed.gov/about/inits/ed/edfacts>. EDFacts SIG:2010-11 (ed.gov/about/inits/ed/edfacts) annually collects cross-sectional data about students, teachers, principals, and schools from states to monitor and rep