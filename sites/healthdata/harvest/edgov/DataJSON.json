",\"CSA\",\"Congressional District\",\"Legistative Districts\"],\r\n      \"modified\": \"2017-06-28\",\r\n      \"publisher\": {\r\n        \"@type\": \"org:Organization\",\r\n        \"name\": \"National Center for Education Statistics\",\r\n        \"subOrganizationOf\": {\r\n          \"@type\": \"org:Organization\",\r\n          \"name\": \"Institute of Education Sciences\",\r\n          \"subOrganizationOf\": {\r\n            \"@type\": \"org:Organization\",\r\n            \"name\": \"U.S. Department of Education\",\r\n            \"subOrganizationOf\": {\r\n              \"@type\": \"org:Organization\",\r\n              \"name\": \"U.S. Government\"\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"contactPoint\": {\r\n        \"@type\": \"vcard:Contact\",\r\n        \"fn\": \"Doug Geverdt\",\r\n        \"hasEmail\": \"mailto:douglas.geverdt@ed.gov\"\r\n      },\r\n      \"identifier\": \"NCES_20141005\",\r\n      \"accessLevel\": \"public\",\r\n      \"bureauCode\": [ \"018:50\" ],\r\n      \"programCode\": [ \"018:000\" ],\r\n      \"license\": \"https://creativecommons.org/publicdomain/zero/1.0/\",\r\n      \"spatial\": \"United States\",\r\n      \"temporal\": \"2011/2014\",\r\n      \"distribution\": [\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"This data file corresponds to EDGE 2013-14 school year and 2015 Census TIGER Year in SAS file format.\",\r\n          \"downloadURL\": \"https://nces.ed.gov/programs/edge/data/GRF15.zip\",\r\n          \"format\": \"Zipped File\",\r\n          \"mediaType\": \"application/zip\",\r\n          \"title\": \"2015 EDGE School District Geographic Relationship Files\"\r\n        },\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"This data file corresponds to EDGE 2013-14 school year and 2014 Census TIGER Year in SAS file format.\",\r\n          \"downloadURL\": \"https://nces.ed.gov/programs/edge/data/GRF14.zip\",\r\n          \"format\": \"Zipped File\",\r\n          \"mediaType\": \"application/zip\",\r\n          \"title\": \"2014 EDGE School District Geographic Relationship Files\"\r\n        },\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"This data file corresponds to EDGE 2011-12 school year and 2013 Census TIGER Year in SAS file format.\",\r\n          \"downloadURL\": \"https://nces.ed.gov/programs/edge/data/GRF13.zip\",\r\n          \"format\": \"Zipped File\",\r\n          \"mediaType\": \"application/zip\",\r\n          \"title\": \"2013 EDGE School District Geographic Relationship Files\"\r\n        }\r\n      ],\r\n      \"accrualPeriodicity\": \"R/P1Y\",\r\n      \"dataQuality\": true,\r\n      \"language\": [ \"en-US\" ],\r\n      \"landingPage\": \"https://nces.ed.gov/programs/edge/geographicRelationshipFiles.aspx\"\r\n    },\r\n    {\r\n      \"@type\": \"dcat:Dataset\",\r\n      \"title\": \"NCES Locale Boundaries\",\r\n      \"description\": \"The NCES locale framework classifies all territory in the U.S. into four types of areas -- City, Suburban, Town, and Rural. Each area is divided into three subtypes based on population size (in the case of City and Suburban assignments) and proximity to urban areas (in the case of Town and Rural assignments). The classifications PDF File (318 KB) rely on standard urban and rural designations defined by the U.S. Census Bureau, and each type of locale is either urban or rural in its entirety. The NCES locales can be fully collapsed into a basic urban/rural dichotomy, or expanded into a more detailed collection of twelve distinct categories. NCES provides a locale assignment for each institution in its administrative data collections (Common Core of Data (CCD), Integrated Post-secondary Education Data Set (IPEDS), and the Private School Survey (PSS)), and locale assignments are included as an indicator in most NCES school-based sample surveys.\",\r\n      \"keyword\": [\"