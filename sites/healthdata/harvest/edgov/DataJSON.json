tment of Education\",\r\n            \"subOrganizationOf\": {\r\n              \"@type\": \"org:Organization\",\r\n              \"name\": \"U.S. Government\"\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"contactPoint\": {\r\n        \"@type\": \"vcard:Contact\",\r\n        \"fn\": \"John Ralph\",\r\n        \"hasEmail\": \"mailto:john.ralph@ed.gov\"\r\n      },\r\n      \"identifier\": \"NCES_2001037\",\r\n      \"accessLevel\": \"public\",\r\n      \"bureauCode\": [ \"018:50\" ],\r\n      \"programCode\": [ \"018:000\" ],\r\n      \"license\": \"https://creativecommons.org/publicdomain/zero/1.0/\",\r\n      \"spatial\": \"United States\",\r\n      \"temporal\": \"1998/1999\",\r\n      \"distribution\": [\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"Advanced Telecommunications in U.S. Private Schools, 1998-99 data in a zipped DAT file\",\r\n          \"downloadURL\": \"https://nces.ed.gov/surveys/frss/download/data/f68data.zip\",\r\n          \"format\": \"Zipped DAT\",\r\n          \"mediaType\": \"application/zip\",\r\n          \"title\": \"f68data.zip\"\r\n        },\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"Advanced Telecommunications in U.S. Private Schools, 1998-99 data in a zipped SAS file\",\r\n          \"downloadURL\": \"https://nces.ed.gov/surveys/frss/download/data/f68sas.zip\",\r\n          \"format\": \"Zipped SAS\",\r\n          \"mediaType\": \"application/zip\",\r\n          \"title\": \"f68sas.zip\"\r\n        }\r\n      ],\r\n      \"accrualPeriodicity\": \"irregular\",\r\n      \"dataQuality\": true,\r\n      \"issued\": \"2003-05-06\",\r\n      \"language\": [ \"en-US\" ],\r\n      \"landingPage\": \"https://nces.ed.gov/surveys/frss/\",\r\n      \"references\": [ \"https://nces.ed.gov/surveys/frss/download/data/f68doc.zip\" ],\r\n      \"systemOfRecords\": \"https://www2.ed.gov/notices/sorn/18-13-01_060499.pdf\"\r\n    },\r\n    {\r\n      \"@type\": \"dcat:Dataset\",\r\n      \"title\": \"Service-Learning and Community Service in K-12 Public Schools, 1999\",\r\n      \"description\": \"Service-Learning and Community Service in K-12 Public Schools, 1999 (FRSS 71), is a study that is part of the Fast Response Survey System (FRSS) program; program data is available since 1998-99 at https://nces.ed.gov/surveys/frss/downloads.asp. FRSS 71 https://nces.ed.gov/surveys/frss/index.asp is a cross-sectional study that was designed to assess the prevalence and support for service-learning programs in K-12 schools across the nation. This study was conducted using surveys of elementary, middle, and secondary/combined school principals. Public elementary schools (200), middle schools (500), and secondary/combined schools (1,300) were sampled. The study's unweighted response rate was 92 percent and the weighted response rate was 93 percent. Key statistics produced from FRSS 71 were on the prevalence of service-learning activities in K-12 schools.\",\r\n      \"keyword\": [ \"Service-learning\", \"Community service\", \"Public schools\", \"Elementary school\", \"Middle school\", \"High school\", \"Secondary/combined schools\", \"Principals\", \"Fast Response Survey System\", \"FRSS\", \"National Center for Education Statistics\", \"NCES\", \"Institute of Education Sciences\", \"IES\" ],\r\n      \"modified\": \"2003-05-06\",\r\n      \"publisher\": {\r\n        \"@type\": \"org:Organization\",\r\n        \"name\": \"National Center for Education Statistics\",\r\n        \"subOrganizationOf\": {\r\n          \"@type\": \"org:Organization\",\r\n          \"name\": \"Institute of Education Sciences\",\r\n          \"subOrganizationOf\": {\r\n            \"@type\": \"org:Organization\",\r\n            \"name\": \"U.S. Department of Education\",\r\n            \"subOrganizationOf\": {\r\n              \"@type\": \"org:Organization\",\r\n              \"name\": \"U.S. Government\"\r\n            }\r\n        