\"R/P1Y\",\r\n      \"dataQuality\": true,\r\n      \"language\": [ \"en-US\" ],\r\n      \"landingPage\": \"https://nces.ed.gov/programs/edge/geographicLocale.aspx\"\r\n    },\r\n    {\r\n      \"@type\": \"dcat:Dataset\",\r\n      \"title\": \"Rural Education Achievement Program Locale Boundaries, 2014\",\r\n      \"description\": \"Prior to 2016, the U.S. Department of Education previously relied on legacy geographic classification framework to support the needs of the Rural Education Achievement Program (REAP), an initiative that targets resources and provides additional administrative flexibility for small school systems that serve rural areas. REAP adopted the NCES locale framework when the program was reauthorized in 2015, but the EDGE program retains the REAP locale boundary layer as a resource for research. The REAP locale framework classified all territory in the U.S. into four types of areas -- City, Urban Fringe, Town, and Rural. Each area is divided into two subtypes based on population size (in the case of City, Urban Fringe, and Town assignments) and proximity to metropolitan areas (in the case of Rural assignments).  \",\r\n      \"keyword\": [\"Locale\",\"Urban\",\"Rural\",\"Town\",\"REAP\",\"Census Bureau\",\"Metropolitan\",\"Principle City\"],\r\n      \"modified\": \"2017-06-28\",\r\n      \"publisher\": {\r\n        \"@type\": \"org:Organization\",\r\n        \"name\": \"National Center for Education Statistics\",\r\n        \"subOrganizationOf\": {\r\n          \"@type\": \"org:Organization\",\r\n          \"name\": \"Institute of Education Sciences\",\r\n          \"subOrganizationOf\": {\r\n            \"@type\": \"org:Organization\",\r\n            \"name\": \"U.S. Department of Education\",\r\n            \"subOrganizationOf\": {\r\n              \"@type\": \"org:Organization\",\r\n              \"name\": \"U.S. Government\"\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"contactPoint\": {\r\n        \"@type\": \"vcard:Contact\",\r\n        \"fn\": \"Doug Geverdt\",\r\n        \"hasEmail\": \"mailto:douglas.geverdt@ed.gov\"\r\n      },\r\n      \"identifier\": \"NCES_20141003\",\r\n      \"accessLevel\": \"public\",\r\n      \"bureauCode\": [ \"018:50\" ],\r\n      \"programCode\": [ \"018:000\" ],\r\n      \"license\": \"https://creativecommons.org/publicdomain/zero/1.0/\",\r\n      \"spatial\": \"United States\",\r\n      \"temporal\": \"2014/2014\",\r\n      \"distribution\": [\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"2014 REAP Locale Boundaries, All States, in shapefile format.\",\r\n          \"downloadURL\": \"https://nces.ed.gov/programs/edge/data/EDGE_LOCALE14_REAP_ALL_US.zip\",\r\n          \"format\": \"Zipped File\",\r\n          \"mediaType\": \"application/zip\",\r\n          \"title\": \"2014 EDGE Locale Boundaries: REAP Locales, All States\"\r\n        },\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"2014 REAP Locale Boundaries, Alabama, in shapefile format.\",\r\n          \"downloadURL\": \"https://nces.ed.gov/programs/edge/data/EDGE_LOCALE14_REAP_STATES/EDGE_LOCALE14_REAP_AL.zip\",\r\n          \"format\": \"Zipped File\",\r\n          \"mediaType\": \"application/zip\",\r\n          \"title\": \"2014 EDGE Locale Boundaries: REAP Locales, Alabama\"\r\n        },\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"2014 REAP Locale Boundaries, Alaska, in shapefile format.\",\r\n          \"downloadURL\": \"https://nces.ed.gov/programs/edge/data/EDGE_LOCALE14_REAP_STATES/EDGE_LOCALE14_REAP_AK.zip\",\r\n          \"format\": \"Zipped File\",\r\n          \"mediaType\": \"application/zip\",\r\n          \"title\": \"2014 EDGE Locale Boundaries: REAP Locales, Alaska\"\r\n        },\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"description\": \"2014 REAP Locale Boundaries, American Samoa, in shapefile format