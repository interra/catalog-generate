"license\": \"https://creativecommons.org/publicdomain/zero/1.0/\",\r\n      \"spatial\": \"United States\",\r\n      \"temporal\": \"2012/2013\",\r\n      \"distribution\": [\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"accessURL\": \"https://perkins.ed.gov/pims/DataExplorer/\",\r\n          \"description\": \"Carl D. Perkins Career and Technical Education Act of 2006 Consolidated Annual Report, 2012-13 data available through the Perkins Data Explorer\",\r\n          \"format\": \"API\",\r\n          \"title\": \"Perkins Data Explorer\"\r\n        }\r\n      ],\r\n      \"accrualPeriodicity\": \"R/P1Y\",\r\n      \"dataQuality\": true,\r\n      \"issued\": \"2015-06-30\",\r\n      \"language\": [ \"en-US\" ],\r\n      \"landingPage\": \"https://perkins.ed.gov/pims/DataExplorer/\"\r\n    },\r\n    {\r\n      \"@type\": \"dcat:Dataset\",\r\n      \"title\": \"Civil Rights Data Collection, 2004\",\r\n      \"description\": \"The Civil Rights Data Collection, 2004 (CRDC 2004), is part of the Civil Rights Data Collection (CRDC) program. CRDC 2004 (https://ocrdata.ed.gov/) is a cross-sectional survey that collects data on key education and civil rights issues in the nation's public school, including student enrollment and educational programs and services, disaggregated by race/ethnicity, sex, limited English proficiency, and disability. The study was conducted using surveys of LEAs and the schools in the LEAs. LEAs and BOCES-type regional education centers functioning as LEAs were sampled. Prior to 2011-12, charter schools were primarily sampled if they were part of a LEA, not if they were a separate charter school district. For CRDC 2004, the response rates, including partial respondents to the data collection, were approximately 97% of all LEAs (95% of all LEAs responded completely with clean data-which is consistent with the 2002 Elementary and Secondary Survey), and 97% of all schools (94% of all schools responded completely with clean data). Key statistics produced from CRDC 2004 can provide information about critical civil rights issues as well as contextual information on the state of civil rights in the nation, including enrollment demographics, advanced placement, discipline, and special education services.\",\r\n      \"keyword\": [ \"Elementary and secondary education\", \"Civil rights\", \"Discrimination\", \"Schools\", \"Students\", \"Education of students with disabilities\", \"Sex discrimination\", \"Minority groups\", \"Special education services\", \"Student discipline\", \"Mental retardation\", \"Graduation testing\", \"Student pregnancy\", \"Advanced placement\", \"Enrollment demographics\" ],\r\n      \"modified\": \"2007-03-27\",\r\n      \"publisher\": {\r\n        \"@type\": \"org:Organization\",\r\n        \"name\": \"Office for Civil Rights\",\r\n        \"subOrganizationOf\": {\r\n          \"@type\": \"org:Organization\",\r\n          \"name\": \"U.S. Department of Education\",\r\n          \"subOrganizationOf\": {\r\n            \"@type\": \"org:Organization\",\r\n            \"name\": \"U.S. Government\"\r\n          }\r\n        }\r\n      },\r\n      \"contactPoint\": {\r\n        \"@type\": \"vcard:Contact\",\r\n        \"fn\": \"Janis Brown\",\r\n        \"hasEmail\": \"mailto:Janis.Brown@ED.gov\"\r\n      },\r\n      \"identifier\": \"OCR_2005001\",\r\n      \"accessLevel\": \"public\",\r\n      \"bureauCode\": [ \"018:00\" ],\r\n      \"programCode\": [ \"018:000\" ],\r\n      \"license\": \"https://creativecommons.org/publicdomain/zero/1.0/\",\r\n      \"spatial\": \"United States\",\r\n      \"temporal\": \"2003/2004\",\r\n      \"distribution\": [\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"accessURL\": \"https://ocrdata.ed.gov/flex/Reports.aspx?type=school\",\r\n          \"description\": \"View and compare data across multiple schools and districts\",\r\n          \"title\": \"School Search\"\r\n        },\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"accessURL\": \"https://ocrdata.ed.gov/flex/Reports.aspx?type=district\",\r\n          \"description\": \"View and compare data across multiple schools and districts\",\r\n          \"title\": \"District Search\"\r\n        },\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"accessURL\": \"https://ocrdata.ed.gov/DistrictSchoolSearch\",\r\n          \"description\": \"Find school- or district-level summaries; access all data for a single school or district\",\r\n          \"title\": \"School/District Search\"\r\n        }\r\n      ],\r\n      \"accrualPeriodicity\": \"R/P2Y\",\r\n      \"dataQuality\": true,\r\n      \"issued\": \"2007-03-27\",\r\n      \"language\": [ \"en-US\" ],\r\n      \"landingPage\": \"https://ocrdata.ed.gov/\",\r\n      \"references\": [ \"https://ocrdata.ed.gov/Overview\", \"https://ocrdata.ed.gov/downloads/UserGuide.pdf\", \"https://ocrdata.ed.gov/downloads/FAQ.pdf\",\"https://ocrdata.ed.gov/Downloads/2004_ED102-school.pdf\" ]\r\n    },\r\n    {\r\n      \"@type\": \"dcat:Dataset\",\r\n      \"title\": \"Civil Rights Data Collection, 2006\",\r\n      \"description\": \"The Civil Rights Data Collection, 2006 (CRDC 2006), is part of the Civil Rights Data Collection (CRDC) program. CRDC 2006 (https://ocrdata.ed.gov/) is a cross-sectional survey that collects data on key education and civil rights issues in the nation's public schools, which include student enrollment and educational programs and services, disaggregated by race/ethnicity, sex, limited English proficiency, and disability. LEAs submit administrative records about schools in the district. LEAs and BOCES-type regional education centers functioning as LEAs were sampled. Prior to 2011-12, charter schools were primarily sampled if they were part of a LEA, not if they were a separate charter school district. CRDC 2006 achieved an unprecedented 100% response rate for LEAs and a 99.6 % response rate for schools. Key statistics produced from CRDC 2006 can provide information about critical civil rights issues as well as contextual information on the state of civil rights in the nation, including enrollment demographics, advanced placement, discipline, and special education services.\",\r\n      \"keyword\": [ \"Elementary and secondary education\", \"Civil rights\", \"Discrimination\", \"Schools\", \"Students\", \"Education of students with disabilities\", \"Sex discrimination\", \"Minority groups\", \"Special education services\", \"Student discipline\", \"Mental retardation\", \"Graduation testing\", \"Student pregnancy\", \"Advanced placement\", \"Enrollment demographics\" ],\r\n      \"modified\": \"2009-11-25\",\r\n      \"publisher\": {\r\n        \"@type\": \"org:Organization\",\r\n        \"name\": \"Office for Civil Rights\",\r\n        \"subOrganizationOf\": {\r\n          \"@type\": \"org:Organization\",\r\n          \"name\": \"U.S. Department of Education\",\r\n          \"subOrganizationOf\": {\r\n            \"@type\": \"org:Organization\",\r\n            \"name\": \"U.S. Government\"\r\n          }\r\n        }\r\n      },\r\n      \"contactPoint\": {\r\n        \"@type\": \"vcard:Contact\",\r\n        \"fn\": \"Janis Brown\",\r\n        \"hasEmail\": \"mailto:Janis.Brown@ED.gov\"\r\n      },\r\n      \"identifier\": \"OCR_2007001\",\r\n      \"accessLevel\": \"public\",\r\n      \"bureauCode\": [ \"018:00\" ],\r\n      \"programCode\": [ \"018:000\" ],\r\n      \"license\": \"https://creativecommons.org/publicdomain/zero/1.0/\",\r\n      \"spatial\": \"United States\",\r\n      \"temporal\": \"2006/2007\",\r\n      \"distribution\": [\r\n        {\r\n          \"@type\": \"dcat:Distribution\",\r\n          \"accessURL\": \"https://ocrdata.ed.gov/flex/Reports.aspx?type=school\",\r\n          \"description\": \"View and compare data across multiple schools and districts\",\r\n          \"title\": \"School Search\"\r\n        },\r\n        {\r\n          \"@type